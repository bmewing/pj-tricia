# Copy to .env.local for local development. None of these are secrets.
VITE_KINDE_DOMAIN=https://<your-business>.kinde.com
VITE_KINDE_CLIENT_ID=
VITE_KINDE_AUDIENCE=https://api.pjtricia

# Where the dev server proxies /api. Change it if the backend runs on another port.
API_PROXY_TARGET=http://localhost:8000
