# Copy to .env for local development.

ENVIRONMENT=development

# Local Postgres (see README for creating the role and database).
# For Neon, paste the *pooled* connection string (host has -pooler in it); the
# postgresql:// scheme and sslmode are adapted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://pjtricia:pjtricia@localhost:5432/pjtricia

# Kinde: same domain and audience as the frontend's .env.local. Not secrets.
KINDE_DOMAIN=https://<your-business>.kinde.com
KINDE_AUDIENCE=https://api.pjtricia

# Where the web app runs, for links back to it.
APP_URL=http://localhost:5173
